# Everything is optional. With no keys the app runs in demo mode:
# scripted agents over cached mainnet data, in-memory ledger, estimated inference cost.

# NEAR AI Cloud key (https://cloud.near.ai). Enables real inference and the milestone-llm agent.
NEAR_AI_API_KEY=
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# Read-only mainnet RPC used by `swarm fetch` (default: free FastNEAR endpoint)
# NEAR_RPC_URL=https://free.rpc.fastnear.com

# Deployed swarm contract (enables the wallet buttons) and its network
SWARM_CONTRACT_ID=
NEAR_NETWORK=testnet
SWARM_ACCOUNT=vetwork.testnet

# Assumed NEAR/USD rate, only used to convert inference USD into a NEAR charge
NEAR_USD=3.00
